# Copy this to .env and fill with your credentials (do NOT commit .env)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5501/auth/google/callback
SESSION_SECRET=change-this-secret
NODE_ENV=development
# Flask specific
FLASK_SECRET_KEY=change-this-secret
FLASK_PORT=5501
FLASK_UPLOAD_FOLDER=uploads
# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-password
MYSQL_DATABASE=securechain
# Node / server
PORT=5500
